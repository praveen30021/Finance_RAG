# Copy this file to .env and fill in real values. .env is gitignored - never commit real keys.

# Groq API key (LLM backend for RAG generation, free tier).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model. Default is qwen/qwen3.6-27b -
# see config.py for why (every Llama model was decommissioned/unavailable
# when this was built).
GROQ_MODEL=qwen/qwen3.6-27b

# Optional: only needed if you extend NewsIngestion with a NewsAPI-based source
NEWSAPI_KEY=
